# Copied to .env by setup.sh. Keep .env private: the bot token lets anyone control the bot.

# Token of a NEW bot from @BotFather on Telegram. Don't reuse the LinkedIn bot's token:
# two programs can't read the same bot's messages at once.
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id. Leave it empty at first, start the bot and message it:
# it replies with your id. Put the id here and restart. After that, it answers only you.
OWNER_CHAT_ID=

# The model file. setup.sh fills this in.
MODEL_FILE=

# CPU threads for the model. The M30 has 2 fast and 6 slow cores: try 2, 4 and 8, keep the fastest.
THREADS=4

# How much text the model can hold at once, in tokens (about 0.75 words each). More uses more memory.
CONTEXT=2048

# Longest reply, in tokens.
MAX_REPLY_TOKENS=400

# Local port the model server listens on. Only this phone can reach it.
LLM_PORT=8080

# Voice for voiceovers (hear them with /voices in Telegram). phone.env sets it.
VOICE=en_US-kristin-medium-int8

# Voice pace: 1 is the voice's own pace, 0.9 is 10% slower and calmer.
VOICE_SPEED=1

# Speaking style (hear them with /styles): plain = Piper as is; natural = pauses after sentences and
# between parts, slower opening and closing line; lively = natural plus more varied intonation.
VOICE_STYLE=natural

# If VOICE fails (e.g. Kokoro runs out of memory), the voiceover is made with this voice instead.
FALLBACK_VOICE=en_US-kristin-medium-int8

# Daily verse: script and voiceover sent to Telegram at this time, India time (e.g. 06:00). Empty = off.
DAILY_TIME=
