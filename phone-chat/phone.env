# Phone settings kept in git, so nothing has to be typed on the phone. start.sh copies each line into
# .env on every start and these values win over .env. Never put the bot token or your chat id here:
# they belong in .env, which git ignores.
# Voiceover: Kokoro Bella at 0.9 speed, spoken straight through (style plain), like the online demo.
# Kristin (Piper) steps in if Kokoro fails. Hear voices with /voices, styles with /styles.
VOICE=kokoro-af_bella
VOICE_SPEED=0.9
VOICE_STYLE=plain
FALLBACK_VOICE=en_US-kristin-medium-int8
# Daily verse script + voiceover sent to Telegram at this time (India time). Empty = off.
DAILY_TIME=06:00
